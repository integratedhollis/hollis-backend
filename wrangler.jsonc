{
  "name": "hollis-backend",
  "account_id": "0d2352e28b9c43c101cd703fd9c17ac3",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-07",
  "vars": {
    "FIREBASE_PROJECT_ID": "hollis-edd21"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollis",
      "database_id": "af908206-3150-4454-a467-6d902dd99885",
      "migrations_dir": "migrations"
    }
  ]
}